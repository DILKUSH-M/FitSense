{
  "name": "fitsense-monorepo",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently -n frontend,backend -c cyan,magenta \"npm --prefix frontend run dev -- --host 0.0.0.0\" \"npm --prefix backend run dev\"",
    "dev:frontend": "npm --prefix frontend run dev -- --host 0.0.0.0",
    "dev:backend": "npm --prefix backend run dev",
    "build": "npm --prefix frontend run build",
    "lint": "npm --prefix frontend run lint",
    "start": "npm --prefix backend run start",
    "start:backend": "npm --prefix backend run start",
    "test": "npm --prefix backend run test"
  },
  "dependencies": {
    "concurrently": "^10.0.7"
  }
}
