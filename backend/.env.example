PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/fitsense
JWT_SECRET=replace_with_secure_secret
CLIENT_URL=http://localhost:5173
FITNESS_HISTORY_DEMO_EMAIL=history-demo@fitsense.invalid
FITNESS_HISTORY_DEMO_PASSWORD=
FITNESS_HISTORY_TIME_ZONE=UTC
# Optional fixed end date for reproducible sample generation (YYYY-MM-DD).
FITNESS_HISTORY_AS_OF_DAY=
# Optional path to Fitbit's dailyActivity_merged.csv.
FITBIT_DAILY_ACTIVITY_CSV=
# Optional participant ID; otherwise the participant with most daily rows is selected.
FITBIT_PARTICIPANT_ID=
